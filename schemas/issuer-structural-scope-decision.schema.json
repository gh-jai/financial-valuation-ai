{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://fvi.example/schemas/issuer-structural-scope-decision.schema.json", "title": "FVI M9-I2 Structural Scope Decision",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "scope_decision_id", "created_at", "evaluated_at", "verified_identity_id", "verified_identity_hash", "scope_registry_id", "scope_registry_version", "scope_registry_hash", "structural_rule_ids", "deferred_matrix_row_ids", "reason_codes", "blocking_errors", "outcome", "eligible_for_m9_data_review", "lifecycle_route_status", "scope_decision_hash"],
  "properties": {"schema_version": {"const": "0.1.0"}, "canonicalization_version": {"const": "fvi-canonical-json-v1"}, "scope_decision_id": {"type": "string", "pattern": "^ISD-[A-Z0-9-]+$"}, "created_at": {"$ref": "#/$defs/time"}, "evaluated_at": {"$ref": "#/$defs/time"}, "verified_identity_id": {"type": "string", "pattern": "^VID-[A-Z0-9-]+$"}, "verified_identity_hash": {"$ref": "#/$defs/hash"}, "scope_registry_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}, "scope_registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "scope_registry_hash": {"$ref": "#/$defs/hash"}, "structural_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}}, "deferred_matrix_row_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^M8-[A-Z0-9-]+$"}}, "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^SCOPE-[A-Z0-9-]+$"}}, "blocking_errors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/error"}}, "outcome": {"enum": ["eligible_for_data_review", "unsupported", "insufficient_evidence"]}, "eligible_for_m9_data_review": {"type": "boolean"}, "lifecycle_route_status": {"const": "not_evaluated"}, "scope_decision_hash": {"$ref": "#/$defs/hash"}},
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "eligible_for_data_review"}}, "required": ["outcome"]}, "then": {"properties": {"eligible_for_m9_data_review": {"const": true}, "blocking_errors": {"maxItems": 0}, "reason_codes": {"minItems": 1, "maxItems": 1, "items": {"const": "SCOPE-IN-SCOPE-PENDING-REVIEW"}}}}},
    {"if": {"properties": {"outcome": {"enum": ["unsupported", "insufficient_evidence"]}}, "required": ["outcome"]}, "then": {"properties": {"eligible_for_m9_data_review": {"const": false}, "blocking_errors": {"minItems": 1}}}}
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "time": {"type": "string", "format": "date-time", "pattern": "Z$"}, "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "severity", "retryable", "artifact_refs", "next_action"], "properties": {"code": {"type": "string", "pattern": "^SCOPE-[A-Z0-9-]+$"}, "message": {"type": "string", "minLength": 1, "maxLength": 320}, "severity": {"const": "blocking"}, "retryable": {"const": false}, "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"}}, "next_action": {"enum": ["verify_identity", "update_registry", "stop"]}}}}
}
