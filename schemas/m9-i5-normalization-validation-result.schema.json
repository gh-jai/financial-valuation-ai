{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/m9-i5-normalization-validation-result.schema.json",
  "title": "FVI M9-I5 Independent Normalization Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization_version",
    "validation_id",
    "normalization_id",
    "normalization_hash",
    "mapping_hash",
    "period_graph_hash",
    "source_snapshot_hash",
    "implementation_separation",
    "network_state",
    "synthetic_only",
    "findings",
    "passed",
    "validation_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "canonicalization_version": {"const": "fvi-canonical-json-v1"},
    "validation_id": {"type": "string", "pattern": "^NVAL-[A-F0-9]{24}$"},
    "normalization_id": {"type": "string", "pattern": "^NRM-[A-F0-9]{24}$"},
    "normalization_hash": {"$ref": "#/$defs/hash"},
    "mapping_hash": {"$ref": "#/$defs/hash"},
    "period_graph_hash": {"$ref": "#/$defs/hash"},
    "source_snapshot_hash": {"$ref": "#/$defs/hash"},
    "implementation_separation": {"const": "independent"},
    "network_state": {"const": "denied"},
    "synthetic_only": {"const": true},
    "findings": {
      "type": "array",
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/finding"}
    },
    "passed": {"type": "boolean"},
    "validation_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"passed": {"const": true}}, "required": ["passed"]},
      "then": {"properties": {"findings": {"maxItems": 0}}},
      "else": {"properties": {"findings": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "subject_refs"],
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^NORM-[A-Z0-9-]+$"
        },
        "severity": {"enum": ["review", "blocking"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 256},
        "subject_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,127}$"}
        }
      }
    }
  }
}
