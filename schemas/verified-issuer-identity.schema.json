{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://fvi.example/schemas/verified-issuer-identity.schema.json", "title": "FVI M9-I2 Verified Issuer Identity",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "verified_identity_id", "created_at", "verified_at", "selection_id", "selection_hash", "candidate_set_hash", "selected_candidate_hash", "cik", "legal_name", "ticker", "exchange_code", "listing_status", "listing_effective_from", "listing_effective_to", "active_listing_evidence_hashes", "primary_listing_country", "primary_reporting_currency", "issuer_class", "regulated_capital_model_required", "reserve_real_option_required", "public_company_status", "identity_observed_at", "identity_age_seconds", "freshness_evaluated_at", "freshness_policy_ref", "catalog_record_hash", "source_record_refs", "identity_status", "verified_identity_hash"],
  "properties": {"schema_version": {"const": "0.1.0"}, "canonicalization_version": {"const": "fvi-canonical-json-v1"}, "verified_identity_id": {"type": "string", "pattern": "^VID-[A-Z0-9-]+$"}, "created_at": {"$ref": "#/$defs/time"}, "verified_at": {"$ref": "#/$defs/time"}, "selection_id": {"type": "string", "pattern": "^ISL-[A-Z0-9-]+$"}, "selection_hash": {"$ref": "#/$defs/hash"}, "candidate_set_hash": {"$ref": "#/$defs/hash"}, "selected_candidate_hash": {"$ref": "#/$defs/hash"}, "cik": {"type": "string", "pattern": "^[0-9]{10}$"}, "legal_name": {"type": "string", "minLength": 1}, "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"}, "exchange_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$"}, "listing_status": {"const": "active"}, "listing_effective_from": {"$ref": "#/$defs/time"}, "listing_effective_to": {"type": "null"}, "active_listing_evidence_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}, "primary_listing_country": {"type": "string", "pattern": "^[A-Z]{2}$"}, "primary_reporting_currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "issuer_class": {"$ref": "#/$defs/issuerClass"}, "regulated_capital_model_required": {"type": "boolean"}, "reserve_real_option_required": {"type": "boolean"}, "public_company_status": {"const": "active"}, "identity_observed_at": {"$ref": "#/$defs/time"}, "identity_age_seconds": {"type": "integer", "minimum": 0}, "freshness_evaluated_at": {"$ref": "#/$defs/time"}, "freshness_policy_ref": {"$ref": "#/$defs/hash"}, "catalog_record_hash": {"$ref": "#/$defs/hash"}, "source_record_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"}}, "identity_status": {"const": "verified"}, "verified_identity_hash": {"$ref": "#/$defs/hash"}},
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "time": {"type": "string", "format": "date-time", "pattern": "Z$"}, "issuerClass": {"enum": ["operating_non_financial", "bank", "deposit_taking", "insurer", "broker_dealer", "other_regulated_capital_financial", "reit", "fund", "etf", "investment_company", "non_operating_holding_vehicle", "spac_blank_check", "unknown"]}}
}
