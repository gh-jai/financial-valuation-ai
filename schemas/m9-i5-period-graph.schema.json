{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/m9-i5-period-graph.schema.json",
  "title": "FVI M9-I5 Deterministic Period Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization_version",
    "period_graph_id",
    "source_snapshot_id",
    "source_snapshot_hash",
    "mapping_id",
    "mapping_hash",
    "network_state",
    "synthetic_only",
    "nodes",
    "edges",
    "period_graph_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "canonicalization_version": {"const": "fvi-canonical-json-v1"},
    "period_graph_id": {"type": "string", "pattern": "^PGR-[A-F0-9]{24}$"},
    "source_snapshot_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^SNP-[A-Z0-9-]+$"
    },
    "source_snapshot_hash": {"$ref": "#/$defs/hash"},
    "mapping_id": {"type": "string", "pattern": "^MAP-[A-F0-9]{24}$"},
    "mapping_hash": {"$ref": "#/$defs/hash"},
    "network_state": {"const": "denied"},
    "synthetic_only": {"const": true},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/edge"}
    },
    "period_graph_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_id",
        "basis",
        "start",
        "end",
        "fiscal_year",
        "fiscal_period",
        "duration_days",
        "filing_record_ref",
        "accession",
        "filed_at",
        "amendment_of_accession",
        "selection_status"
      ],
      "properties": {
        "period_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^PER-[A-Z0-9-]+$"
        },
        "basis": {"enum": ["annual", "quarterly", "year-to-date", "ttm", "instant"]},
        "start": {"type": ["string", "null"], "format": "date"},
        "end": {"type": "string", "format": "date"},
        "fiscal_year": {"type": "integer", "minimum": 1900, "maximum": 9999},
        "fiscal_period": {"enum": ["FY", "Q1", "Q2", "Q3", "Q4", "TTM", "INSTANT"]},
        "duration_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 550},
        "filing_record_ref": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^REC-[A-Z0-9-]+$"
        },
        "accession": {"type": "string", "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
        "filed_at": {"type": "string", "maxLength": 64, "format": "date-time"},
        "amendment_of_accession": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
        },
        "selection_status": {"enum": ["selected", "superseded", "review"]}
      },
      "allOf": [
        {
          "if": {"properties": {"basis": {"const": "instant"}}, "required": ["basis"]},
          "then": {
            "properties": {
              "start": {"type": "null"},
              "duration_days": {"type": "null"},
              "fiscal_period": {"const": "INSTANT"}
            }
          }
        },
        {
          "if": {
            "properties": {"basis": {"enum": ["annual", "quarterly", "year-to-date", "ttm"]}},
            "required": ["basis"]
          },
          "then": {
            "properties": {
              "start": {"type": "string", "format": "date"},
              "duration_days": {"type": "integer", "minimum": 1, "maximum": 550}
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "relationship", "from_period_ids", "to_period_id"],
      "properties": {
        "edge_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^PEDGE-[A-Z0-9-]+$"
        },
        "relationship": {
          "enum": [
            "quarter-to-ytd",
            "ytd-to-annual",
            "annual-rollup",
            "ttm-composition",
            "prior-instant-to-current",
            "split-adjustment",
            "amendment-supersedes"
          ]
        },
        "from_period_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^PER-[A-Z0-9-]+$"
          }
        },
        "to_period_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^PER-[A-Z0-9-]+$"
        }
      }
    }
  }
}
