{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/sec-adapter-result.schema.json",
  "title": "FVI M9-I4 SEC Adapter Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "result_id", "created_at", "policy_hash", "provider_registry_hash", "provider_id", "capability", "endpoint_id", "request_fingerprint", "activation_state", "network_state", "user_agent_policy_valid", "attempts", "cache", "raw_record", "status", "errors", "result_hash"],
  "properties": {
    "schema_version": {"const": "0.1.0"}, "canonicalization_version": {"const": "fvi-canonical-json-v1"},
    "result_id": {"type": "string", "pattern": "^SAR-[A-Z0-9-]+$"}, "created_at": {"$ref": "#/$defs/time"},
    "policy_hash": {"$ref": "#/$defs/hash"}, "provider_registry_hash": {"$ref": "#/$defs/hash"},
    "provider_id": {"enum": ["sec-identity", "sec-submissions", "sec-filings", "sec-xbrl"]},
    "capability": {"enum": ["identity", "submissions", "filings", "companyfacts"]},
    "endpoint_id": {"enum": ["sec-company-tickers-v1", "sec-submissions-by-cik-v1", "sec-filing-document-v1", "sec-companyfacts-by-cik-v1"]},
    "request_fingerprint": {"$ref": "#/$defs/hash"}, "activation_state": {"const": "disabled"}, "network_state": {"const": "denied"},
    "user_agent_policy_valid": {"type": "boolean"},
    "attempts": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/attempt"}},
    "cache": {"$ref": "#/$defs/cache"},
    "raw_record": {"oneOf": [{"$ref": "#/$defs/rawRecord"}, {"type": "null"}]},
    "status": {"enum": ["failed", "succeeded"]},
    "errors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/error"}},
    "result_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]}, "then": {"properties": {"raw_record": {"$ref": "#/$defs/rawRecord"}, "errors": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}, "then": {"properties": {"raw_record": {"type": "null"}, "errors": {"minItems": 1}}}},
    {"if": {"properties": {"capability": {"const": "identity"}}, "required": ["capability"]}, "then": {"properties": {"provider_id": {"const": "sec-identity"}, "endpoint_id": {"const": "sec-company-tickers-v1"}}}},
    {"if": {"properties": {"capability": {"const": "submissions"}}, "required": ["capability"]}, "then": {"properties": {"provider_id": {"const": "sec-submissions"}, "endpoint_id": {"const": "sec-submissions-by-cik-v1"}}}},
    {"if": {"properties": {"capability": {"const": "filings"}}, "required": ["capability"]}, "then": {"properties": {"provider_id": {"const": "sec-filings"}, "endpoint_id": {"const": "sec-filing-document-v1"}}}},
    {"if": {"properties": {"capability": {"const": "companyfacts"}}, "required": ["capability"]}, "then": {"properties": {"provider_id": {"const": "sec-xbrl"}, "endpoint_id": {"const": "sec-companyfacts-by-cik-v1"}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "attempt": {"type": "object", "additionalProperties": false, "required": ["attempt", "token_sequence", "started_at", "ended_at", "outcome"], "properties": {"attempt": {"type": "integer", "minimum": 1, "maximum": 3}, "token_sequence": {"type": "integer", "minimum": 1}, "started_at": {"$ref": "#/$defs/time"}, "ended_at": {"$ref": "#/$defs/time"}, "outcome": {"enum": ["connection_reset_before_response", "http_429", "http_500", "http_502", "http_503", "http_504", "response_accepted", "timeout"]}}},
    "cache": {"type": "object", "additionalProperties": false, "required": ["disposition", "index_hash", "published"], "properties": {"disposition": {"enum": ["bypassed", "hit", "miss", "rejected"]}, "index_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "published": {"type": "boolean"}}},
    "rawRecord": {"type": "object", "additionalProperties": false, "required": ["record_id", "content_hash", "byte_count", "media_type"], "properties": {"record_id": {"type": "string", "pattern": "^REC-[A-Z0-9-]+$"}, "content_hash": {"$ref": "#/$defs/hash"}, "byte_count": {"type": "integer", "minimum": 1, "maximum": 1048576}, "media_type": {"type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$"}}},
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "severity", "retryable", "artifact_refs", "next_action"], "properties": {"code": {"enum": ["SEC-ADAPTER-DISABLED", "SEC-CACHE-TAMPER", "SEC-CIRCUIT-OPEN", "SEC-ENDPOINT-DENIED", "SEC-HASH-MISMATCH", "SEC-PROVIDER-DENIED", "SEC-RATE-LIMITED", "SEC-REDIRECT-DENIED", "SEC-RESPONSE-INTEGRITY", "SEC-RESPONSE-OVERSIZE", "SEC-TRANSPORT-RESET", "SEC-TRANSPORT-TIMEOUT", "SEC-UPSTREAM-REJECTED", "SEC-UPSTREAM-RETRYABLE", "SEC-USER-AGENT-DENIED"]}, "message": {"type": "string", "minLength": 1, "maxLength": 240}, "severity": {"enum": ["blocking", "review", "warning"]}, "retryable": {"type": "boolean"}, "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"}}, "next_action": {"enum": ["contact_support", "retry_later", "stop", "update_registry"]}}, "allOf": [{"if": {"properties": {"retryable": {"const": true}}, "required": ["retryable"]}, "then": {"properties": {"next_action": {"const": "retry_later"}}}, "else": {"properties": {"next_action": {"not": {"const": "retry_later"}}}}}]}
  }
}
