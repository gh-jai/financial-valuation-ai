{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/issuer-identity-catalog.schema.json",
  "title": "FVI M9-I2 Synthetic Issuer Identity Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "catalog_id", "catalog_version", "status", "effective_at", "expires_at", "reviewed_at", "reviewed_by", "review_evidence", "adapter_id", "network_state", "evidence_records", "records", "catalog_hash"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "canonicalization_version": {"const": "fvi-canonical-json-v1"},
    "catalog_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["pending", "approved", "rejected"]},
    "effective_at": {"$ref": "#/$defs/time"},
    "expires_at": {"$ref": "#/$defs/time"},
    "reviewed_at": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "reviewed_by": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
    "review_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "network_state": {"const": "denied"},
    "evidence_records": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "records": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/record"}},
    "catalog_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]}, "then": {"properties": {"reviewed_at": {"type": "null"}, "reviewed_by": {"type": "null"}, "review_evidence": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"enum": ["approved", "rejected"]}}, "required": ["status"]}, "then": {"properties": {"reviewed_at": {"$ref": "#/$defs/time"}, "reviewed_by": {"type": "string", "minLength": 1}, "review_evidence": {"minItems": 1}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_record_id", "source_kind", "observed_at", "fact_as_of", "assertion_kind", "cik", "legal_name", "ticker", "exchange_code", "asserted_effective_from", "asserted_effective_to", "evidence_record_hash"],
      "properties": {
        "source_record_id": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"},
        "source_kind": {"const": "synthetic_identity"},
        "observed_at": {"$ref": "#/$defs/time"},
        "fact_as_of": {"$ref": "#/$defs/time"},
        "assertion_kind": {"enum": ["active_as_of", "closed_interval"]},
        "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
        "legal_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
        "exchange_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$"},
        "asserted_effective_from": {"$ref": "#/$defs/time"},
        "asserted_effective_to": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "evidence_record_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "listing": {
      "type": "object", "additionalProperties": false,
      "required": ["ticker", "exchange_code", "effective_from", "effective_to", "evidence_record_refs", "listing_entry_hash"],
      "properties": {
        "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
        "exchange_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$"},
        "effective_from": {"$ref": "#/$defs/time"},
        "effective_to": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "evidence_record_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"}},
        "listing_entry_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "cik", "legal_name", "aliases", "listing_history", "primary_listing_country", "primary_reporting_currency", "issuer_class", "regulated_capital_model_required", "reserve_real_option_required", "public_company_status", "identity_observed_at", "source_record_refs", "catalog_record_hash"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^RID-[A-Z0-9-]+$"},
        "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
        "legal_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "listing_history": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/listing"}},
        "primary_listing_country": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "primary_reporting_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "issuer_class": {"enum": ["operating_non_financial", "bank", "deposit_taking", "insurer", "broker_dealer", "other_regulated_capital_financial", "reit", "fund", "etf", "investment_company", "non_operating_holding_vehicle", "spac_blank_check", "private_company", "unknown"]},
        "regulated_capital_model_required": {"type": "boolean"},
        "reserve_real_option_required": {"type": "boolean"},
        "public_company_status": {"enum": ["active", "suspended", "delisted", "inactive", "private"]},
        "identity_observed_at": {"$ref": "#/$defs/time"},
        "source_record_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"}},
        "catalog_record_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
