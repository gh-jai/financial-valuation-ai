{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/issuer-structural-scope-registry.schema.json",
  "title": "FVI M9-I2 Structural Scope Registry",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "scope_registry_id", "scope_registry_version", "status", "effective_at", "expires_at", "reviewed_at", "reviewed_by", "review_evidence", "m8_support_matrix_ref", "m8_support_matrix_sha256", "rules", "deferred_matrix_rows", "scope_registry_hash"],
  "properties": {
    "schema_version": {"const": "0.1.0"}, "canonicalization_version": {"const": "fvi-canonical-json-v1"},
    "scope_registry_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "scope_registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["pending", "approved", "rejected"]}, "effective_at": {"$ref": "#/$defs/time"}, "expires_at": {"$ref": "#/$defs/time"},
    "reviewed_at": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}, "reviewed_by": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
    "review_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "m8_support_matrix_ref": {"const": "docs/product/retail-v1-issuer-support-matrix.md"}, "m8_support_matrix_sha256": {"$ref": "#/$defs/hash"},
    "rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/rule"}},
    "deferred_matrix_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["row_id", "status"], "properties": {"row_id": {"type": "string", "pattern": "^M8-[A-Z0-9-]+$"}, "status": {"const": "deferred_to_m10"}}}},
    "scope_registry_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]}, "then": {"properties": {"reviewed_at": {"type": "null"}, "reviewed_by": {"type": "null"}, "review_evidence": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"enum": ["approved", "rejected"]}}, "required": ["status"]}, "then": {"properties": {"reviewed_at": {"$ref": "#/$defs/time"}, "reviewed_by": {"type": "string", "minLength": 1}, "review_evidence": {"minItems": 1}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "time": {"type": "string", "format": "date-time", "pattern": "Z$"}, "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "predicate": {"type": "object", "additionalProperties": false, "required": ["field", "operator", "value"], "properties": {"field": {"enum": ["public_company_status", "primary_listing_country", "primary_reporting_currency", "issuer_class", "regulated_capital_model_required", "reserve_real_option_required"]}, "operator": {"enum": ["equals", "not_equals"]}, "value": {"type": ["string", "boolean"]}}},
    "rule": {"type": "object", "additionalProperties": false, "required": ["rule_id", "priority", "predicates", "outcome", "reason_code", "evaluation_stage"], "properties": {"rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}, "priority": {"type": "integer", "minimum": 0}, "predicates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/predicate"}}, "outcome": {"enum": ["eligible_for_data_review", "unsupported"]}, "reason_code": {"enum": ["SCOPE-IN-SCOPE-PENDING-REVIEW", "SCOPE-UNSUPPORTED-FINANCIAL", "SCOPE-UNSUPPORTED-REIT", "SCOPE-UNSUPPORTED-FUND", "SCOPE-UNSUPPORTED-SPAC", "SCOPE-UNSUPPORTED-NATURAL-RESOURCE", "SCOPE-UNSUPPORTED-NON-US", "SCOPE-UNSUPPORTED-NON-USD", "SCOPE-UNSUPPORTED-PRIVATE"]}, "evaluation_stage": {"const": "m9-i2-structural"}}}
  }
}
