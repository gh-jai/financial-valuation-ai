{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://fvi.example/schemas/issuer-resolution-validation-result.schema.json", "title": "FVI M9-I2 Independent Validation Result",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "validation_result_id", "created_at", "validator_id", "validator_version", "implementation_separation", "subjects", "findings", "status", "validation_result_hash"],
  "properties": {"schema_version": {"const": "0.1.0"}, "canonicalization_version": {"const": "fvi-canonical-json-v1"}, "validation_result_id": {"type": "string", "pattern": "^IVR-[A-Z0-9-]+$"}, "created_at": {"$ref": "#/$defs/time"}, "validator_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}, "validator_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "implementation_separation": {"const": "independent"}, "subjects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_kind", "artifact_id", "artifact_hash"], "properties": {"artifact_kind": {"enum": ["company_request", "identity_catalog", "identity_policy", "candidate_set", "selection", "verified_identity", "scope_registry", "scope_decision"]}, "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "artifact_hash": {"$ref": "#/$defs/hash"}}}}, "findings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/finding"}}, "status": {"enum": ["passed", "failed"]}, "validation_result_hash": {"$ref": "#/$defs/hash"}},
  "allOf": [{"if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}, "then": {"properties": {"findings": {"maxItems": 0}}}}, {"if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}, "then": {"properties": {"findings": {"minItems": 1}}}}],
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "time": {"type": "string", "format": "date-time", "pattern": "Z$"}, "finding": {"type": "object", "additionalProperties": false, "required": ["code", "message", "severity", "retryable", "artifact_refs", "next_action"], "properties": {"code": {"type": "string", "pattern": "^IDENTITY-[A-Z0-9-]+$"}, "message": {"type": "string", "minLength": 1, "maxLength": 320}, "severity": {"const": "blocking"}, "retryable": {"const": false}, "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"}}, "next_action": {"const": "stop"}}}}
}
