{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/sec-adapter-policy.schema.json",
  "title": "FVI M9-I4 Disabled SEC Adapter Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "policy_id", "policy_version", "status", "activation_state", "network_state", "provider_registry_id", "provider_registry_hash", "capabilities", "header_policy", "global_rate_limit", "retry_policy", "timeout_policy", "circuit_breaker", "cache_policy", "global_kill_switch", "policy_hash"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "canonicalization_version": {"const": "fvi-canonical-json-v1"},
    "policy_id": {"const": "m9-i4-sec-adapter-policy"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "candidate"},
    "activation_state": {"const": "disabled"},
    "network_state": {"const": "denied"},
    "provider_registry_id": {"const": "m9-provider-license"},
    "provider_registry_hash": {"$ref": "#/$defs/hash"},
    "capabilities": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
    "header_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_headers", "authentication_class", "user_agent_policy", "store_user_agent_value", "caller_headers_allowed"],
      "properties": {
        "allowed_headers": {"const": ["Accept", "Host", "User-Agent"]},
        "authentication_class": {"const": "user_agent"},
        "user_agent_policy": {"const": "operator_configured_not_stored"},
        "store_user_agent_value": {"const": false},
        "caller_headers_allowed": {"const": false}
      }
    },
    "global_rate_limit": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "window_seconds", "max_requests", "burst_capacity", "clock", "scheduler", "queue_limit", "queue_order"],
      "properties": {
        "algorithm": {"const": "deterministic_token_bucket_v1"}, "window_seconds": {"const": 1},
        "max_requests": {"const": 1}, "burst_capacity": {"const": 1}, "clock": {"const": "injected_monotonic"},
        "scheduler": {"const": "injected"}, "queue_limit": {"const": 32},
        "queue_order": {"const": "eligible_at_then_request_sequence"}
      }
    },
    "retry_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attempts", "backoff_seconds", "jitter", "retryable_http_statuses", "retryable_transport_events"],
      "properties": {
        "max_attempts": {"const": 3}, "backoff_seconds": {"const": [1, 2]}, "jitter": {"const": "none"},
        "retryable_http_statuses": {"const": [429, 500, 502, 503, 504]},
        "retryable_transport_events": {"const": ["connection_reset_before_response", "timeout"]}
      }
    },
    "timeout_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["clock", "connect_seconds", "read_idle_seconds", "total_seconds", "outer_deadline_resets"],
      "properties": {"clock": {"const": "injected_monotonic"}, "connect_seconds": {"const": 5}, "read_idle_seconds": {"const": 20}, "total_seconds": {"const": 30}, "outer_deadline_resets": {"const": false}}
    },
    "circuit_breaker": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "states", "failure_threshold", "open_seconds", "half_open_probe_limit", "clock", "persists_across_restart"],
      "properties": {
        "scope": {"const": "provider_id_and_capability"}, "states": {"const": ["closed", "half_open", "open"]},
        "failure_threshold": {"const": 5}, "open_seconds": {"const": 60}, "half_open_probe_limit": {"const": 1},
        "clock": {"const": "injected_monotonic"}, "persists_across_restart": {"const": false}
      }
    },
    "cache_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["store_contract", "write_once", "index_canonicalization", "rehash_on_read", "rights_recheck", "kill_switch_recheck", "fallback_on_tamper"],
      "properties": {
        "store_contract": {"const": "m9-i3-content-addressed-store-v1"}, "write_once": {"const": true},
        "index_canonicalization": {"const": "fvi-canonical-json-v1"}, "rehash_on_read": {"const": true},
        "rights_recheck": {"const": true}, "kill_switch_recheck": {"const": true}, "fallback_on_tamper": {"const": false}
      }
    },
    "global_kill_switch": {"const": "disabled"},
    "policy_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["order", "capability", "provider_id", "endpoint_id", "endpoint_template", "host", "redirect_policy", "accept_media", "max_decoded_body_bytes", "kill_switch"],
      "properties": {
        "order": {"type": "integer", "minimum": 0, "maximum": 3},
        "capability": {"enum": ["identity", "submissions", "filings", "companyfacts"]},
        "provider_id": {"enum": ["sec-identity", "sec-submissions", "sec-filings", "sec-xbrl"]},
        "endpoint_id": {"enum": ["sec-company-tickers-v1", "sec-submissions-by-cik-v1", "sec-filing-document-v1", "sec-companyfacts-by-cik-v1"]},
        "endpoint_template": {"type": "string", "pattern": "^https://(?:www|data)\\.sec\\.gov/"},
        "host": {"enum": ["data.sec.gov", "www.sec.gov"]},
        "redirect_policy": {"const": "deny_all"},
        "accept_media": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$"}},
        "max_decoded_body_bytes": {"enum": [8388608, 16777216, 25165824, 33554432]},
        "kill_switch": {"const": "disabled"}
      },
      "allOf": [
        {"if": {"properties": {"capability": {"const": "identity"}}, "required": ["capability"]}, "then": {"properties": {"order": {"const": 0}, "provider_id": {"const": "sec-identity"}, "endpoint_id": {"const": "sec-company-tickers-v1"}, "endpoint_template": {"const": "https://www.sec.gov/files/company_tickers.json"}, "host": {"const": "www.sec.gov"}, "accept_media": {"const": ["application/json"]}, "max_decoded_body_bytes": {"const": 8388608}}}},
        {"if": {"properties": {"capability": {"const": "submissions"}}, "required": ["capability"]}, "then": {"properties": {"order": {"const": 1}, "provider_id": {"const": "sec-submissions"}, "endpoint_id": {"const": "sec-submissions-by-cik-v1"}, "endpoint_template": {"const": "https://data.sec.gov/submissions/CIK{cik}.json"}, "host": {"const": "data.sec.gov"}, "accept_media": {"const": ["application/json"]}, "max_decoded_body_bytes": {"const": 16777216}}}},
        {"if": {"properties": {"capability": {"const": "filings"}}, "required": ["capability"]}, "then": {"properties": {"order": {"const": 2}, "provider_id": {"const": "sec-filings"}, "endpoint_id": {"const": "sec-filing-document-v1"}, "endpoint_template": {"const": "https://www.sec.gov/Archives/edgar/data/{cik}/{accession_compact}/{document}"}, "host": {"const": "www.sec.gov"}, "accept_media": {"const": ["application/xml", "text/html", "text/plain"]}, "max_decoded_body_bytes": {"const": 25165824}}}},
        {"if": {"properties": {"capability": {"const": "companyfacts"}}, "required": ["capability"]}, "then": {"properties": {"order": {"const": 3}, "provider_id": {"const": "sec-xbrl"}, "endpoint_id": {"const": "sec-companyfacts-by-cik-v1"}, "endpoint_template": {"const": "https://data.sec.gov/api/xbrl/companyfacts/CIK{cik}.json"}, "host": {"const": "data.sec.gov"}, "accept_media": {"const": ["application/json"]}, "max_decoded_body_bytes": {"const": 33554432}}}}
      ]
    }
  }
}
