{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fvi.example/schemas/identity-resolution-policy.schema.json",
  "title": "FVI M9-I2 Identity Resolution Policy",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "identity_policy_id", "identity_policy_version", "status", "effective_at", "expires_at", "reviewed_at", "reviewed_by", "review_evidence", "normalization_version", "allowed_query_kinds", "allowed_match_kinds", "match_ranks", "max_identity_age_seconds", "timestamp_rule", "interval_rule", "issuer_classes", "required_classification_fields", "evidence_assertion_kinds", "derived_temporal_classifications", "public_company_statuses", "synthetic_adapter_ids", "network_state", "supported_primary_listing_countries", "supported_reporting_currencies", "synthetic_exchange_codes", "identity_policy_hash"],
  "properties": {
    "schema_version": {"const": "0.1.0"}, "canonicalization_version": {"const": "fvi-canonical-json-v1"},
    "identity_policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "identity_policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["pending", "approved", "rejected"]},
    "effective_at": {"$ref": "#/$defs/time"}, "expires_at": {"$ref": "#/$defs/time"},
    "reviewed_at": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "reviewed_by": {"type": ["string", "null"], "minLength": 1, "maxLength": 80},
    "review_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "normalization_version": {"const": "m9-i2-name-nfkc-casefold-v1"},
    "allowed_query_kinds": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["cik", "company_name", "ticker"]}},
    "allowed_match_kinds": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/matchKind"}},
    "match_ranks": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["match_kind", "rank", "precedence"], "properties": {"match_kind": {"$ref": "#/$defs/matchKind"}, "rank": {"enum": [0, 10]}, "precedence": {"type": "integer", "minimum": 0, "maximum": 4}}}},
    "max_identity_age_seconds": {"type": "integer", "minimum": 1, "maximum": 315576000},
    "timestamp_rule": {"const": "injected-rfc3339-utc"}, "interval_rule": {"const": "half-open"},
    "issuer_classes": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"$ref": "#/$defs/issuerClass"}},
    "required_classification_fields": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["issuer_class", "primary_listing_country", "primary_reporting_currency", "public_company_status", "regulated_capital_model_required", "reserve_real_option_required"]}},
    "evidence_assertion_kinds": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["active_as_of", "closed_interval"]}},
    "derived_temporal_classifications": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["current", "future", "historical"]}},
    "public_company_statuses": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["active", "delisted", "inactive", "private", "suspended"]}},
    "synthetic_adapter_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}},
    "network_state": {"const": "denied"},
    "supported_primary_listing_countries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}$"}},
    "supported_reporting_currencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{3}$"}},
    "synthetic_exchange_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$"}},
    "identity_policy_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]}, "then": {"properties": {"reviewed_at": {"type": "null"}, "reviewed_by": {"type": "null"}, "review_evidence": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"enum": ["approved", "rejected"]}}, "required": ["status"]}, "then": {"properties": {"reviewed_at": {"$ref": "#/$defs/time"}, "reviewed_by": {"type": "string", "minLength": 1}, "review_evidence": {"minItems": 1}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "matchKind": {"enum": ["cik_exact", "ticker_current_exact", "ticker_historical_exact", "legal_name_exact", "declared_alias_exact"]},
    "issuerClass": {"enum": ["operating_non_financial", "bank", "deposit_taking", "insurer", "broker_dealer", "other_regulated_capital_financial", "reit", "fund", "etf", "investment_company", "non_operating_holding_vehicle", "spac_blank_check", "private_company", "unknown"]}
  }
}
