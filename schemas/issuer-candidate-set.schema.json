{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://fvi.example/schemas/issuer-candidate-set.schema.json",
  "title": "FVI M9-I2 Issuer Candidate Set", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "candidate_set_id", "created_at", "resolution_at", "canonicalization_version", "request_id", "company_request_hash", "resolver_version", "normalization_version", "catalog_id", "catalog_version", "catalog_hash", "identity_policy_id", "identity_policy_version", "identity_policy_hash", "query_kind", "normalized_query", "status", "candidates", "errors", "candidate_set_hash"],
  "properties": {
    "schema_version": {"const": "0.1.0"}, "candidate_set_id": {"type": "string", "pattern": "^ICS-[A-Z0-9-]+$"}, "created_at": {"$ref": "#/$defs/time"}, "resolution_at": {"$ref": "#/$defs/time"},
    "canonicalization_version": {"const": "fvi-canonical-json-v1"}, "request_id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"}, "company_request_hash": {"$ref": "#/$defs/hash"},
    "resolver_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "normalization_version": {"const": "m9-i2-name-nfkc-casefold-v1"},
    "catalog_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}, "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "catalog_hash": {"$ref": "#/$defs/hash"},
    "identity_policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}, "identity_policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "identity_policy_hash": {"$ref": "#/$defs/hash"},
    "query_kind": {"enum": ["ticker", "cik", "company_name"]}, "normalized_query": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {"enum": ["unique_candidate", "selection_required", "not_found", "blocked"]}, "candidates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/candidate"}}, "errors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/error"}}, "candidate_set_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "unique_candidate"}}, "required": ["status"]}, "then": {"properties": {"candidates": {"minItems": 1, "maxItems": 1}, "errors": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "selection_required"}}, "required": ["status"]}, "then": {"properties": {"candidates": {"minItems": 2}, "errors": {"minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/error"}, {"properties": {"code": {"const": "IDENTITY-AMBIGUOUS"}, "severity": {"const": "blocking"}, "retryable": {"const": false}, "next_action": {"const": "verify_identity"}}}]}}}}},
    {"if": {"properties": {"status": {"const": "not_found"}}, "required": ["status"]}, "then": {"properties": {"candidates": {"maxItems": 0}, "errors": {"minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/error"}, {"properties": {"code": {"const": "IDENTITY-NOT-FOUND"}, "severity": {"const": "blocking"}, "retryable": {"const": false}, "next_action": {"const": "verify_identity"}}}]}}}}},
    {"if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]}, "then": {"properties": {"errors": {"minItems": 1, "contains": {"properties": {"severity": {"const": "blocking"}}, "required": ["severity"]}}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "severity", "retryable", "artifact_refs", "next_action"], "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"}, "message": {"type": "string", "minLength": 1, "maxLength": 320}, "severity": {"enum": ["blocking", "review", "warning"]}, "retryable": {"type": "boolean"}, "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"}}, "next_action": {"enum": ["verify_identity", "update_registry", "retry_later", "contact_support", "stop"]}}},
    "matchedListing": {"type": "object", "additionalProperties": false, "required": ["listing_entry_hash", "ticker", "exchange_code", "derived_temporal_classification", "effective_from", "effective_to", "evidence_record_hashes"], "properties": {"listing_entry_hash": {"$ref": "#/$defs/hash"}, "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"}, "exchange_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$"}, "derived_temporal_classification": {"enum": ["current", "historical", "future"]}, "effective_from": {"$ref": "#/$defs/time"}, "effective_to": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}, "evidence_record_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "primary_match_kind", "match_kinds", "match_rank", "cik", "legal_name", "ticker", "exchange_code", "listing_status", "listing_effective_from", "listing_effective_to", "active_listing_evidence_hashes", "matched_listing_refs", "primary_listing_country", "primary_reporting_currency", "issuer_class", "regulated_capital_model_required", "reserve_real_option_required", "public_company_status", "identity_observed_at", "source_record_refs", "catalog_record_hash", "candidate_hash"], "properties": {"candidate_id": {"type": "string", "pattern": "^ICD-[A-F0-9]{64}$"}, "primary_match_kind": {"$ref": "#/$defs/matchKind"}, "match_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/matchKind"}}, "match_rank": {"enum": [0, 10]}, "cik": {"type": "string", "pattern": "^[0-9]{10}$"}, "legal_name": {"type": "string", "minLength": 1, "maxLength": 200}, "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"}, "exchange_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$"}, "listing_status": {"const": "active"}, "listing_effective_from": {"$ref": "#/$defs/time"}, "listing_effective_to": {"type": "null"}, "active_listing_evidence_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}, "matched_listing_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/matchedListing"}}, "primary_listing_country": {"type": "string", "pattern": "^[A-Z]{2}$"}, "primary_reporting_currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "issuer_class": {"$ref": "#/$defs/issuerClass"}, "regulated_capital_model_required": {"type": "boolean"}, "reserve_real_option_required": {"type": "boolean"}, "public_company_status": {"enum": ["active", "suspended", "delisted", "inactive", "private"]}, "identity_observed_at": {"$ref": "#/$defs/time"}, "source_record_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"}}, "catalog_record_hash": {"$ref": "#/$defs/hash"}, "candidate_hash": {"$ref": "#/$defs/hash"}}},
    "matchKind": {"enum": ["cik_exact", "ticker_current_exact", "ticker_historical_exact", "legal_name_exact", "declared_alias_exact"]},
    "issuerClass": {"enum": ["operating_non_financial", "bank", "deposit_taking", "insurer", "broker_dealer", "other_regulated_capital_financial", "reit", "fund", "etf", "investment_company", "non_operating_holding_vehicle", "spac_blank_check", "private_company", "unknown"]}
  }
}
